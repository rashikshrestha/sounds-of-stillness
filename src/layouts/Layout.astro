---
import Nav from '../components/Nav.astro';

const { title } = Astro.props;
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>{title}</title>
    <script is:inline>
      (function () {
        try {
          const stored = localStorage.getItem('theme');
          const theme =
            stored ||
            (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
          document.documentElement.setAttribute('data-theme', theme);
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <Nav />
    <slot />
  </body>
</html>

<style is:global>
  :root {
    --bg: #ffffff;
    --text: #111111;
    --border: #ddd;
  }
  :root[data-theme='dark'] {
    --bg: #121212;
    --text: #f0f0f0;
    --border: #333;
  }
  body {
    background: var(--bg);
    color: var(--text);
  }
</style>
