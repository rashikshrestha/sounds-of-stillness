---
const path = Astro.url.pathname;
const isHome = path === '/';
---
<nav id="site-nav" class={isHome ? 'nav nav-transparent' : 'nav'}>
  <a href="/" class="brand">Sounds of Stillness</a>

  <div class="right">
    <a href="/" class="nav-link" aria-current={path === '/' ? 'page' : undefined}>Home</a>
    <a href="/blog" class="nav-link" aria-current={path === '/blog' ? 'page' : undefined}>Blog</a>

    <button id="theme-toggle" class="toggle-btn" aria-label="Toggle theme">
      <svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="5" />
        <line x1="12" y1="1" x2="12" y2="3" />
        <line x1="12" y1="21" x2="12" y2="23" />
        <line x1="4.22" y1="4.22" x2="5.64" y2="5.64" />
        <line x1="18.36" y1="18.36" x2="19.78" y2="19.78" />
        <line x1="1" y1="12" x2="3" y2="12" />
        <line x1="21" y1="12" x2="23" y2="12" />
        <line x1="4.22" y1="19.78" x2="5.64" y2="18.36" />
        <line x1="18.36" y1="5.64" x2="19.78" y2="4.22" />
      </svg>
      <svg class="icon-moon" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
      </svg>
    </button>
  </div>
</nav>

<script define:vars={{ isHome }}>
  const nav = document.getElementById('site-nav');

  if (isHome && nav) {
    function onScroll() {
      const scrolledPast = window.scrollY > window.innerHeight * 0.85;
      nav.classList.toggle('nav-transparent', !scrolledPast);
    }
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  }

  const btn = document.getElementById('theme-toggle');

  function updateThemeButton() {
    const isDark = document.documentElement.getAttribute('data-theme') !== 'light';
    btn?.setAttribute('aria-label', isDark ? 'Switch to light theme' : 'Switch to dark theme');
    btn?.setAttribute('title', isDark ? 'Light mode' : 'Dark mode');
    btn?.classList.toggle('is-dark', isDark);
  }

  updateThemeButton();

  btn?.addEventListener('click', () => {
    const isDark = document.documentElement.getAttribute('data-theme') !== 'light';
    const next = isDark ? 'light' : 'dark';
    document.documentElement.setAttribute('data-theme', next);
    localStorage.setItem('theme', next);
    updateThemeButton();
  });
</script>

<style>
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 24px 48px;
    background: var(--nav-scrolled-bg);
    backdrop-filter: blur(5px);
    border-bottom: 1px solid var(--nav-scrolled-border);
    transition: background 0.4s ease, border-bottom 0.4s ease;
  }

  .nav-transparent {
    background: transparent;
    backdrop-filter: none;
    border-bottom: none;
  }

  .brand {
    font-family: var(--font-head);
    font-size: 20px;
    font-style: italic;
    font-weight: 300;
    color: var(--text);
    letter-spacing: 1px;
    white-space: nowrap;
  }

  .right {
    display: flex;
    align-items: center;
    gap: 32px;
  }

  .nav-link {
    font-family: var(--font-body);
    font-size: 12px;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--text-dim);
    transition: color 0.2s;
  }

  .nav-link[aria-current='page'] {
    color: var(--amber);
  }

  .toggle-btn {
    background: none;
    border: 1px solid rgba(168, 149, 126, 0.35);
    border-radius: 50%;
    width: 34px;
    height: 34px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    color: var(--text-dim);
    padding: 0;
    transition: border-color 0.2s, color 0.2s;
  }

  .toggle-btn:hover {
    border-color: var(--amber);
    color: var(--amber);
  }

  .icon-sun,
  .icon-moon {
    display: none;
  }
  .toggle-btn.is-dark .icon-moon {
    display: block;
  }
  .toggle-btn:not(.is-dark) .icon-sun {
    display: block;
  }

  .nav-transparent .brand,
  .nav-transparent .nav-link,
  .nav-transparent .toggle-btn {
    color: #f0ead8;
  }

  @media (max-width: 480px) {
    .nav {
      padding: 16px 20px;
    }
    .brand {
      font-size: 14px;
      letter-spacing: 0.5px;
    }
    .right {
      gap: 16px;
    }
  }

  @media (max-width: 360px) {
    .brand {
      font-size: 12px;
    }
  }
</style>
