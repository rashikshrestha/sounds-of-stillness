---
import Layout from '../layouts/Layout.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import { formatDate } from '../lib/formatDate';

const posts = await getCollection('posts');
const sorted = posts.sort(
  (a: CollectionEntry<'posts'>, b: CollectionEntry<'posts'>) => b.data.date.valueOf() - a.data.date.valueOf()
);
---
<Layout title="Blog">
  <main class="main">
    <header class="header">
      <p class="eyebrow">Journal</p>
      <h1 class="title">Blog</h1>
      <p class="subtitle">Thoughts gathered on the path of conscious living.</p>
    </header>

    <div class="grid">
      {sorted.map((post: CollectionEntry<'posts'>) => (
        <a href={`/blog/${post.slug}`} class="card">
          <img
            src={post.data.cover ?? '/images/uploads/placeholder.svg'}
            alt={post.data.title}
            class="card-image"
          />
          <div class="card-body">
            <p class="card-date">{formatDate(post.data.date)}</p>
            <h2 class="card-title">{post.data.title}</h2>
            {post.data.excerpt && <p class="card-excerpt">{post.data.excerpt}</p>}
            <span class="read-more">Read more →</span>
          </div>
        </a>
      ))}
    </div>
  </main>
</Layout>

<style>
  .main {
    min-height: 100vh;
    padding-top: 120px;
    padding-bottom: 80px;
    background: var(--bg);
  }
  .header {
    text-align: center;
    padding: 0 40px 72px;
  }
  .eyebrow {
    font-size: 11px;
    letter-spacing: 4px;
    text-transform: uppercase;
    color: var(--amber);
    margin-bottom: 12px;
  }
  .title {
    font-family: var(--font-head);
    font-size: 64px;
    font-weight: 300;
    font-style: italic;
    color: var(--text);
    margin-bottom: 16px;
  }
  .subtitle {
    color: var(--text-dim);
    font-size: 16px;
  }
  .grid {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 40px;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
  }
  .card {
    display: block;
    background: var(--surface);
    overflow: hidden;
    transition: transform 0.3s ease;
  }
  .card:hover {
    transform: translateY(-4px);
    text-decoration: none;
  }
  .card-image {
    width: 100%;
    height: 240px;
    object-fit: cover;
    filter: brightness(0.9);
    transition: filter 0.3s ease;
  }
  .card:hover .card-image {
    filter: brightness(1);
  }
  .card-body {
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .card-date {
    font-size: 11px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--amber);
  }
  .card-title {
    font-family: var(--font-head);
    font-size: 26px;
    font-weight: 300;
    font-style: italic;
    color: var(--text);
    line-height: 1.2;
  }
  .card-excerpt {
    font-size: 14px;
    color: var(--text-dim);
    line-height: 1.75;
  }
  .read-more {
    font-size: 12px;
    letter-spacing: 2px;
    color: var(--amber);
    margin-top: 4px;
  }
  @media (max-width: 900px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 560px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
