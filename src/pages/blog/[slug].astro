---
import Layout from '../../layouts/Layout.astro';
import { getCollection, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

type Props = { post: CollectionEntry<'posts'> };
const { post } = Astro.props as Props;
const { Content } = await post.render();
const coverImage = post.data.coverImage ?? '/images/uploads/placeholder.svg';
---
<Layout title={post.data.title}>
  <main class="main">
    <div class="hero-wrap">
      <img src={coverImage} alt={post.data.title} class="hero-image" />
      <div class="hero-overlay"></div>
      <div class="hero-text">
        <p class="date">{post.data.date.toDateString()}</p>
        <h1 class="title">{post.data.title}</h1>
      </div>
    </div>

    <article class="article">
      <div class="body">
        <Content />
      </div>

      <div class="footer">
        <a href="/blog" class="back-link">← Back to Blog</a>
      </div>
    </article>
  </main>
</Layout>

<style>
  .main {
    min-height: 100vh;
    background: var(--bg);
  }
  .hero-wrap {
    position: relative;
    height: 680px;
    overflow: hidden;
  }
  .hero-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }
  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, transparent 30%, var(--bg) 100%);
  }
  .hero-text {
    position: absolute;
    bottom: 56px;
    left: 50%;
    transform: translateX(-50%);
    text-align: center;
    width: 100%;
    padding: 0 40px;
  }
  .date {
    font-size: 11px;
    letter-spacing: 4px;
    text-transform: uppercase;
    color: var(--amber);
    margin-bottom: 12px;
  }
  .title {
    font-family: var(--font-head);
    font-size: clamp(36px, 5vw, 64px);
    font-weight: 300;
    font-style: italic;
    color: var(--text);
    line-height: 1.15;
  }
  .article {
    max-width: 680px;
    margin: 0 auto;
    padding: 72px 40px 80px;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .body :global(p) {
    font-family: var(--font-body);
    font-size: 18px;
    line-height: 1.9;
    color: var(--text-dim);
  }
  .footer {
    margin-top: 24px;
    padding-top: 32px;
    border-top: 1px solid rgba(196, 133, 58, 0.2);
  }
  .back-link {
    font-size: 12px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--amber);
  }
</style>
