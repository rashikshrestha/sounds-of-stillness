---
import Layout from '../layouts/Layout.astro';
import { getEntry } from 'astro:content';

const home = await getEntry('home', 'index');
const { Content } = await home.render();
const gallery = await getEntry('gallery', 'index');
const quotes = await getEntry('quotes', 'index');
const coverImage = home.data.coverImage ?? '/images/uploads/placeholder.svg';
const aboutImage = home.data.aboutImage ?? '/images/uploads/placeholder.svg';
const connectImage = home.data.connectImage ?? '/images/uploads/placeholder.svg';
const connectSubtitleLines = home.data.connectSubtitle?.split('\n') ?? [];
---
<Layout title={home.data.title}>
  <section class="hero">
    <img src={coverImage} alt="" class="hero-bg" />
    <div class="hero-overlay"></div>
    <div class="hero-content">
      {home.data.author && <p class="eyebrow">{home.data.author}</p>}
      <h1 class="hero-title">{home.data.title}</h1>
      {home.data.description && <p class="hero-tagline">{home.data.description}</p>}
      <a href="#about" class="scroll-down" aria-label="Scroll down">↓</a>
    </div>
  </section>

  <section id="about" class="about">
    <div class="about-inner">
      <div class="about-image-wrap">
        <img class="about-image" src={aboutImage} alt={home.data.aboutTitle ?? 'About'} />
      </div>
      <div class="about-text">
        <p class="eyebrow">About</p>
        {home.data.aboutTitle && <h2 class="about-title">{home.data.aboutTitle}</h2>}
        <div class="about-body">
          <Content />
        </div>
      </div>
    </div>
  </section>

  <section id="gallery" class="gallery-section">
    <div class="section-header">
      <p class="eyebrow">Visual Poetry</p>
      {home.data.galleryTitle && <h2 class="section-heading">{home.data.galleryTitle}</h2>}
    </div>
    <div class="gallery">
      {gallery.data.images.map((photo: { image: string; caption?: string }, i: number) => (
        <div class="gallery-item" data-index={i}>
          <img src={photo.image} alt={photo.caption ?? ''} loading="lazy" />
          {photo.caption && (
            <div class="caption-overlay">
              <p class="caption">{photo.caption}</p>
            </div>
          )}
        </div>
      ))}
    </div>
  </section>

  <div id="lightbox" class="lightbox-backdrop" hidden>
    <button id="lightbox-close" class="lightbox-close" aria-label="Close">✕</button>
    <button id="lightbox-prev" class="lightbox-nav lightbox-nav-prev" aria-label="Previous">←</button>
    <div class="lightbox-content">
      <img id="lightbox-image" class="lightbox-image" src="" alt="" />
      <p id="lightbox-caption" class="lightbox-caption"></p>
    </div>
    <button id="lightbox-next" class="lightbox-nav lightbox-nav-next" aria-label="Next">→</button>
  </div>

  <section id="wisdom" class="words">
    <div class="section-header">
      <p class="eyebrow">Words</p>
      <h2 class="section-heading">Wisdom Gathered Along the Way</h2>
    </div>
    <div class="quote-list">
      {quotes.data.quotes.map((q: { text: string; attribution?: string }) => (
        <div class="quote-block">
          <p class="quote-text">&ldquo;{q.text}&rdquo;</p>
          {q.attribution && <p class="quote-source">— {q.attribution}</p>}
        </div>
      ))}
    </div>
  </section>

  <section id="connect" class="connect">
    <img src={connectImage} alt="" class="connect-bg" />
    <div class="connect-overlay"></div>
    <div class="connect-content">
      <p class="eyebrow">Connect</p>
      {home.data.connectTitle && <h2 class="connect-title">{home.data.connectTitle}</h2>}
      <p class="connect-body">
        {connectSubtitleLines.map((line: string, i: number) => (
          <>
            {i > 0 && <br />}
            {line}
          </>
        ))}
      </p>
      {home.data.connectHandle && (
        <a
          class="connect-handle"
          href={home.data.connectHandleUrl || '#'}
          target="_blank"
          rel="noopener noreferrer"
        >
          {home.data.connectHandle}
        </a>
      )}
      {home.data.connectQuote && <p class="connect-closing">&ldquo;{home.data.connectQuote}&rdquo;</p>}
    </div>
  </section>
</Layout>

<script define:vars={{ photos: gallery.data.images }}>
  const backdrop = document.getElementById('lightbox');
  const imageEl = document.getElementById('lightbox-image');
  const captionEl = document.getElementById('lightbox-caption');
  const closeBtn = document.getElementById('lightbox-close');
  const prevBtn = document.getElementById('lightbox-prev');
  const nextBtn = document.getElementById('lightbox-next');
  const items = document.querySelectorAll('.gallery-item');

  let currentIndex = null;

  function show(index) {
    currentIndex = index;
    const photo = photos[index];
    imageEl.src = photo.image;
    imageEl.alt = photo.caption || '';
    captionEl.textContent = photo.caption || '';
    backdrop.hidden = false;
    document.body.style.overflow = 'hidden';
  }

  function close() {
    currentIndex = null;
    backdrop.hidden = true;
    document.body.style.overflow = '';
  }

  function prev() {
    if (currentIndex === null) return;
    show((currentIndex - 1 + photos.length) % photos.length);
  }

  function next() {
    if (currentIndex === null) return;
    show((currentIndex + 1) % photos.length);
  }

  items.forEach((item) => {
    item.addEventListener('click', () => {
      show(Number(item.dataset.index));
    });
  });

  closeBtn?.addEventListener('click', close);
  prevBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    prev();
  });
  nextBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    next();
  });
  backdrop?.addEventListener('click', (e) => {
    if (e.target === backdrop) close();
  });

  document.addEventListener('keydown', (e) => {
    if (backdrop.hidden) return;
    if (e.key === 'ArrowLeft') prev();
    if (e.key === 'ArrowRight') next();
    if (e.key === 'Escape') close();
  });
</script>

<style>
  .eyebrow {
    font-size: 11px;
    letter-spacing: 4px;
    text-transform: uppercase;
    color: var(--amber);
    margin-bottom: 12px;
  }

  /* Hero always keeps its own moody, dark-image styling regardless of the
     active theme — it overrides --overlay-hero locally rather than using
     the theme's default (which is tuned for text-on-solid-background). */
  .hero {
    position: relative;
    height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    --overlay-hero: linear-gradient(to bottom, rgba(14, 13, 12, 0.3) 0%, rgba(14, 13, 12, 0.6) 100%);
  }
  :root[data-theme='light'] .hero {
    --overlay-hero: linear-gradient(to bottom, rgba(14, 13, 12, 0.01) 0%, rgba(14, 13, 12, 0.15) 100%);
  }
  .hero-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    filter: brightness(0.45);
  }
  .hero-overlay {
    position: absolute;
    inset: 0;
    background: var(--overlay-hero);
  }
  .hero-content {
    position: relative;
    z-index: 1;
    text-align: center;
    padding: 0 24px;
    --amber: #c4853a;
  }
  .hero-title {
    font-family: var(--font-head);
    font-size: clamp(52px, 8vw, 96px);
    font-weight: 300;
    font-style: italic;
    color: #f0ead8;
    line-height: 1.1;
    margin-bottom: 20px;
  }
  .hero-tagline {
    font-family: var(--font-body);
    font-size: 16px;
    color: #a8957e;
    letter-spacing: 1px;
  }
  .scroll-down {
    display: inline-block;
    margin-top: 48px;
    font-size: 24px;
    color: #a8957e;
    opacity: 0.7;
  }

  /* About */
  .about {
    padding: 100px 40px;
    background: var(--surface);
  }
  .about-inner {
    max-width: 1100px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1.75fr;
    gap: 72px;
    align-items: center;
  }
  .about-image-wrap {
    overflow: hidden;
  }
  .about-image {
    width: 100%;
    height: 560px;
    object-fit: cover;
    object-position: center top;
    filter: sepia(15%);
  }
  .about-text {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .about-title {
    font-family: var(--font-head);
    font-size: 42px;
    font-weight: 300;
    font-style: italic;
    color: var(--text);
    line-height: 1.2;
  }
  .about-body :global(p) {
    color: var(--text-dim);
    font-size: 16px;
    line-height: 1.85;
  }
  @media (max-width: 900px) {
    .about-inner {
      grid-template-columns: 1fr;
    }
  }

  /* Shared section header (Gallery / Words) */
  .section-header {
    text-align: center;
    margin-bottom: 56px;
  }
  .section-heading {
    font-family: var(--font-head);
    font-size: 42px;
    font-weight: 300;
    font-style: italic;
    color: var(--text);
  }

  /* Gallery */
  .gallery-section {
    padding: 100px 40px;
    background: var(--bg);
    text-align: center;
  }
  .gallery {
    max-width: 1100px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 8px;
  }
  .gallery-item {
    position: relative;
    overflow: hidden;
    aspect-ratio: 3 / 4;
    cursor: pointer;
  }
  .gallery-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s ease;
  }
  .gallery-item:hover img {
    transform: scale(1.05);
  }
  .caption-overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 32px 16px 16px;
    background: var(--overlay-caption);
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  .gallery-item:hover .caption-overlay {
    opacity: 1;
  }
  .caption {
    color: #f0ead8;
    font-size: 13px;
    letter-spacing: 2px;
    text-transform: uppercase;
  }
  @media (max-width: 900px) {
    .gallery {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* Lightbox */
  .lightbox-backdrop {
    position: fixed;
    inset: 0;
    z-index: 500;
    background: rgba(8, 7, 6, 0.92);
    display: flex;
    align-items: center;
    justify-content: center;
    backdrop-filter: blur(6px);
    animation: fadeIn 0.2s ease;
  }
  .lightbox-backdrop[hidden] {
    display: none;
  }
  @keyframes fadeIn {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
  .lightbox-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    max-width: 80vw;
    max-height: 90vh;
  }
  .lightbox-image {
    max-width: 100%;
    max-height: 80vh;
    object-fit: contain;
    display: block;
    animation: zoomIn 0.2s ease;
  }
  @keyframes zoomIn {
    from {
      transform: scale(0.96);
      opacity: 0;
    }
    to {
      transform: scale(1);
      opacity: 1;
    }
  }
  .lightbox-caption {
    font-size: 12px;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: rgba(240, 234, 216, 0.6);
  }
  .lightbox-close {
    position: absolute;
    top: 24px;
    right: 32px;
    background: none;
    border: 1px solid rgba(240, 234, 216, 0.25);
    border-radius: 50%;
    width: 40px;
    height: 40px;
    color: rgba(240, 234, 216, 0.7);
    font-size: 16px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: border-color 0.2s, color 0.2s;
  }
  .lightbox-close:hover {
    border-color: var(--amber);
    color: var(--amber);
  }
  .lightbox-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: none;
    border: 1px solid rgba(240, 234, 216, 0.25);
    color: rgba(240, 234, 216, 0.7);
    font-size: 22px;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: border-color 0.2s, color 0.2s;
  }
  .lightbox-nav:hover {
    border-color: var(--amber);
    color: var(--amber);
  }
  .lightbox-nav-prev {
    left: 32px;
  }
  .lightbox-nav-next {
    right: 32px;
  }
  @media (max-width: 600px) {
    .lightbox-nav {
      width: 40px;
      height: 40px;
      font-size: 18px;
    }
    .lightbox-nav-prev {
      left: 12px;
    }
    .lightbox-nav-next {
      right: 12px;
    }
  }

  /* Words */
  .words {
    padding: 100px 40px;
    background: var(--surface);
  }
  .quote-list {
    max-width: 760px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 56px;
  }
  .quote-block {
    text-align: center;
    border-top: 1px solid rgba(196, 133, 58, 0.2);
    padding-top: 48px;
  }
  .quote-text {
    font-family: var(--font-head);
    font-size: clamp(22px, 3vw, 30px);
    font-style: italic;
    font-weight: 300;
    color: var(--text);
    line-height: 1.6;
    margin-bottom: 20px;
  }
  .quote-source {
    font-size: 12px;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--amber);
  }

  /* Connect */
  .connect {
    position: relative;
    padding: 120px 40px;
    display: flex;
    justify-content: center;
    overflow: hidden;
  }
  .connect-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 25%;
    filter: var(--section-img-filter);
  }
  .connect-overlay {
    position: absolute;
    inset: 0;
    background: var(--overlay-section);
  }
  .connect-content {
    position: relative;
    z-index: 1;
    text-align: center;
    max-width: 560px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
  }
  .connect-title {
    font-family: var(--font-head);
    font-size: 48px;
    font-weight: 300;
    font-style: italic;
    color: var(--text);
    line-height: 1.2;
  }
  .connect-body {
    color: var(--text-dim);
    font-size: 16px;
    line-height: 1.8;
  }
  .connect-handle {
    display: inline-block;
    margin-top: 8px;
    padding: 12px 32px;
    border: 1px solid var(--amber);
    color: var(--amber);
    letter-spacing: 2px;
    font-size: 13px;
    text-transform: uppercase;
  }
  .connect-closing {
    margin-top: 20px;
    font-style: italic;
    color: var(--text-dim);
    font-size: 15px;
  }

  /* Connect section keeps a dark editorial photo backdrop even in light
     mode, so its text needs to stay warm/light rather than following the
     theme's normal (dark-on-light) text color. */
  :root[data-theme='light'] .connect-title {
    color: #f0e8d6;
  }
  :root[data-theme='light'] .connect-body {
    color: #cbb89a;
  }
  :root[data-theme='light'] .connect .eyebrow {
    color: #e8a650;
  }
  :root[data-theme='light'] .connect-handle {
    border-color: #e8a650;
    color: #e8a650;
  }
  :root[data-theme='light'] .connect-closing {
    color: #c4a882;
  }
</style>
