---
import Layout from '../layouts/Layout.astro';
import { getEntry } from 'astro:content';

const home = await getEntry('home', 'index');
const { Content } = await home.render();
const gallery = await getEntry('gallery', 'index');
---
<Layout title={home.data.title}>
  <img
    class="cover"
    src={home.data.coverImage ?? '/images/uploads/placeholder.svg'}
    alt={home.data.title}
  />
  <h1>{home.data.title}</h1>
  {home.data.description && <p>{home.data.description}</p>}
  <Content />

  <h2>Visual Poetry</h2>
  <div class="gallery">
    {gallery.data.images.map((src: string) => (
      <div class="gallery-item">
        <img src={src} alt="" loading="lazy" />
      </div>
    ))}
  </div>
</Layout>

<style>
  .cover {
    width: 100%;
    max-height: 400px;
    object-fit: cover;
    border-radius: 8px;
  }
  .gallery {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.5rem;
    margin-top: 2rem;
  }
  .gallery-item {
    aspect-ratio: 1 / 1;
    overflow: hidden;
  }
  .gallery-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  @media (max-width: 600px) {
    .gallery {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
